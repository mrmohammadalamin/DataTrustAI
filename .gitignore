# Strictly exclude Word documents, large local video files, and raw root screenshots
datatrust.docx
*.docx
*.doc
.~lock.*
~$*
*.mp4
datatrustai.mp4
/Screenshot *.png

# Python / FastAPI artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Node / TypeScript Frontend build & dependencies
node_modules/
frontend/node_modules/
frontend/dist/
dist/
*.tsbuildinfo

# Terraform & Local Secrets
.terraform/
*.tfstate
*.tfstate.*
.env
.env.*
*.log
